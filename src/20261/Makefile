CC = gcc
001 = Ejemplo001
002 = Ejemplo002
003 = Ejemplo003
004 = Ejemplo004
005 = Ejemplo005
006 = Ejemplo006

all: $(001) $(002) $(003) $(004) $(005) $(006)

$(001): $(001).c
	$(CC) $(001).c -o $(001)

$(002): $(002).c
	$(CC) $(002).c -o $(002)

$(003): $(003).c
	$(CC) $(003).c -o $(003)

$(004): $(004).c
	$(CC) $(004).c -o $(004)

$(005): $(005).c
	$(CC) $(005).c -lm -o $(005)

$(006): $(006).c
	$(CC) $(006).c -o $(006)

clean:
	rm -f $(001) $(002) $(003) $(004) $(005) $(006)